+        transferNamed = WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_BT1886;
+      }
+      break;
+    case gfx::TransferFunction::LINEAR:
+      transferNamed = WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_EXT_LINEAR;
+      break;
+  }
+  if (useNamedTransfer &&
