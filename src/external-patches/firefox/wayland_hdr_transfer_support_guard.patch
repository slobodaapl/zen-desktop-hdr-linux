diff --git a/widget/gtk/nsWaylandDisplay.h b/widget/gtk/nsWaylandDisplay.h
--- a/widget/gtk/nsWaylandDisplay.h
+++ b/widget/gtk/nsWaylandDisplay.h
@@ -124,6 +124,21 @@ class nsWaylandDisplay {
   bool SupportsColorManagerLuminances() const {
     return mColorManagerSupportedFeature.mLuminances;
   }
+  bool SupportsColorManagerTFPower() const {
+    return mColorManagerSupportedFeature.mFTPower;
+  }
+  bool SupportsColorManagerTFNamed(uint32_t aTF) const {
+    return aTF < sColorTransfersNum &&
+           mSupportedTransfer[aTF] == static_cast<int>(aTF);
+  }
+  bool SupportsColorManagerPrimariesNamed(uint32_t aPrimaries) const {
+    return aPrimaries < sColorPrimariesNum &&
+           mSupportedPrimaries[aPrimaries] == static_cast<int>(aPrimaries);
+  }
+  bool SupportsColorManagerBT1886TF() const {
+    return SupportsColorManagerTFNamed(
+        WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_BT1886);
+  }
   void SetSupportedCoefficientsAndRanges(uint32_t aCoefficients,
                                          uint32_t aRange);
   uint32_t GetColorRange(uint32_t aCoefficients, bool aFullRange);
