+bool VideoFramePool<LIBAV_VER>::IsFFmpegVideoFrameSurfaceUsedByRendererLocked(
+    const MutexAutoLock& aProofOfLock, VASurfaceID aFFMPEGSurfaceID) {
+  MOZ_DIAGNOSTIC_ASSERT(
+      aFFMPEGSurfaceID != sInvalidFFMPEGSurfaceID,
+      "IsFFmpegVideoFrameSurfaceUsedByRendererLocked(): expects valid "
+      "aFFMPEGSurfaceID");
+
+  for (const auto& surface : mDMABufSurfaces) {
+    if (surface->mFFMPEGSurfaceID == aFFMPEGSurfaceID &&
+        surface->IsUsedByRenderer()) {
+      return true;
+    }
+  }
+  return false;
+}
